rules_version = '2';

// Sanadi Firestore rules. Paste into Firebase console → Firestore → Rules.
// Nothing is readable without signing in; people only see their own data,
// except the "available" switch of approved teachers (to count them).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function isApproved(uid) {
      let app = /databases/$(db)/documents/teacherApplications/$(uid);
      return exists(app) && get(app).data.status == 'approved';
    }
    function text(v, max) { return v == null || (v is string && v.size() <= max); }

    // Profile: name, role, gender, picture, language.
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'role', 'gender', 'avatar', 'locale', 'updatedAt'])
        && text(request.resource.data.get('name', null), 80)
        && request.resource.data.get('role', null) in [null, 'student', 'teacher']
        && request.resource.data.get('gender', null) in [null, 'male', 'female'];
      allow delete: if isMe(uid);
    }

    // Teacher applications. The applicant can send (or resend after a
    // "not approved"); only an admin can approve or turn down.
    match /teacherApplications/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'gender', 'answers', 'order', 'sampleSec', 'status', 'submittedAt'])
        && request.resource.data.answers.size() <= 20;
      allow update: if (isMe(uid)
          && resource.data.status in ['pending', 'rejected']
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['name', 'gender', 'answers', 'order', 'sampleSec', 'status', 'submittedAt'])
          && request.resource.data.answers.size() <= 20)
        || (isAdmin()
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reason', 'decidedAt', 'decidedBy']));
      // Deleting the account removes the application too.
      allow delete: if isMe(uid);
    }

    // An applicant's recitation sample (at most about 2 minutes of AAC),
    // kept apart so the list of applications stays light.
    match /applicationSamples/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['data', 'durationSec', 'createdAt'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 900000
        && request.resource.data.durationSec is int;
      allow delete: if isMe(uid);
    }

    // "I'm available to teach". Only approved teachers can set it.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && isApproved(uid)
        && request.resource.data.keys().hasOnly(['available', 'gender', 'busy', 'updatedAt'])
        && request.resource.data.available is bool;
      allow delete: if isMe(uid);
    }

    // Chat between a student and a teacher. Only an admin opens a
    // conversation (later: the first lesson), and only between a student
    // and a teacher of the same gender. Only the two members can read it.
    function userDoc(uid) { return get(/databases/$(db)/documents/users/$(uid)).data; }
    function convDoc(cid) { return get(/databases/$(db)/documents/conversations/$(cid)).data; }
    function isMemberOf(cid) { return signedIn() && request.auth.uid in convDoc(cid).members; }
    function callDoc(id) { return get(/databases/$(db)/documents/calls/$(id)).data; }

    match /conversations/{cid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      // ...or the student, right after their first call with that teacher.
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid == request.resource.data.members[0]
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.fromCall is string
        && callDoc(request.resource.data.fromCall).studentId == request.resource.data.members[0]
        && callDoc(request.resource.data.fromCall).teacherId == request.resource.data.members[1]
        && callDoc(request.resource.data.fromCall).status in ['active', 'ended']
        && request.resource.data.gender == callDoc(request.resource.data.fromCall).gender
        && request.resource.data.blockedBy.size() == 0;
      allow create: if isAdmin()
        && request.resource.data.members.size() == 2
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && userDoc(request.resource.data.members[0]).role == 'student'
        && isApproved(request.resource.data.members[1])
        && userDoc(request.resource.data.members[0]).gender == userDoc(request.resource.data.members[1]).gender;
      // Members update the preview, unread counts, their own name and
      // picture, and their own block; never who is in it.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.gender == resource.data.gender
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastText', 'lastVoiceSec', 'lastSender', 'lastAt', 'unread', 'names', 'avatars', 'blockedBy'])
        && request.resource.data.blockedBy.removeAll([request.auth.uid])
             == resource.data.blockedBy.removeAll([request.auth.uid]);
      allow delete: if false;

      function canSend() {
        return isMemberOf(cid) && convDoc(cid).blockedBy.size() == 0
          && request.resource.data.senderId == request.auth.uid;
      }

      match /messages/{mid} {
        allow read: if isMemberOf(cid);
        allow create: if canSend()
          && request.resource.data.sentAt == request.time
          && ((request.resource.data.type == 'text'
                && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'sentAt'])
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 2000)
            || (request.resource.data.type == 'voice'
                && request.resource.data.keys().hasOnly(['senderId', 'type', 'durationSec', 'sentAt'])
                && request.resource.data.durationSec is int
                && request.resource.data.durationSec <= 185));
        allow update: if false;
        allow delete: if isMemberOf(cid) && resource.data.senderId == request.auth.uid;
      }

      // Voice note recordings (at most about 3 minutes of AAC).
      match /audio/{mid} {
        allow read: if isMemberOf(cid);
        allow create: if canSend()
          && request.resource.data.keys().hasOnly(['senderId', 'data', 'createdAt'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000;
        allow update: if false;
        allow delete: if isMemberOf(cid) && resource.data.senderId == request.auth.uid;
      }
    }

    // Calls. The student's app finds a free teacher of the same gender and
    // rings them; the teacher's app answers. Only those two can see a call.
    match /calls/{id} {
      function isStudent() { return signedIn() && request.auth.uid == resource.data.studentId; }
      function isTeacher() { return signedIn() && request.auth.uid == resource.data.teacherId; }
      function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

      allow read: if isStudent() || isTeacher();
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && userDoc(request.auth.uid).role == 'student'
        && request.resource.data.gender == userDoc(request.auth.uid).gender
        && request.resource.data.status == 'searching'
        && request.resource.data.teacherId == null
        && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'studentAvatar', 'gender', 'status',
             'teacherId', 'tried', 'createdAt']);
      // The student rings teachers (approved, same gender), cancels, hangs
      // up and sends the offer.
      allow update: if isStudent()
        && unchanged(['studentId', 'gender', 'teacherName', 'teacherAvatar', 'answer'])
        && (request.resource.data.status in ['searching', 'ringing', 'ended', 'cancelled', 'unmatched']
            || request.resource.data.status == resource.data.status)
        && (request.resource.data.teacherId == resource.data.teacherId
            || (isApproved(request.resource.data.teacherId)
                && userDoc(request.resource.data.teacherId).gender == resource.data.gender));
      // The teacher being rung answers or declines, then sends the answer
      // and can hang up.
      allow update: if isTeacher()
        && unchanged(['studentId', 'studentName', 'studentAvatar', 'gender', 'teacherId', 'tried', 'offer'])
        && request.resource.data.status in ['active', 'declined', 'ended']
        && (resource.data.status in ['ringing', 'active']);
      allow delete: if false;

      // Network routes for the connection, from each side.
      match /ice/{c} {
        allow read: if signedIn() && request.auth.uid in [get(/databases/$(db)/documents/calls/$(id)).data.studentId,
                                                          get(/databases/$(db)/documents/calls/$(id)).data.teacherId];
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
          && ((request.resource.data.from == 'student' && request.auth.uid == callDoc(id).studentId)
              || (request.resource.data.from == 'teacher' && request.auth.uid == callDoc(id).teacherId));
        allow update, delete: if false;
      }
    }

    // Lessons (calls that connected): saved by either person when the call
    // ends, matching the call. Only the teacher writes notes; only the
    // student rates.
    match /sessions/{id} {
      function inLesson() {
        return signedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.teacherId);
      }
      function portion(p) {
        return p == null || (p is map && p.keys().hasOnly(['sura', 'from', 'to'])
          && p.sura is int && p.sura >= 1 && p.sura <= 114 && p.from is int && p.to is int && p.from <= p.to);
      }

      allow read: if inLesson();
      allow create: if signedIn()
        && request.auth.uid in [request.resource.data.studentId, request.resource.data.teacherId]
        && callDoc(id).studentId == request.resource.data.studentId
        && callDoc(id).teacherId == request.resource.data.teacherId
        && callDoc(id).status in ['active', 'ended']
        && request.resource.data.gender == callDoc(id).gender
        && request.resource.data.durationSec is int
        && request.resource.data.keys().hasOnly(['studentId', 'teacherId', 'studentName', 'teacherName',
             'studentAvatar', 'teacherAvatar', 'gender', 'startedAt', 'durationSec', 'createdAt']);
      allow update: if (signedIn() && request.auth.uid == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
          && request.resource.data.notes.keys().hasOnly(['recited', 'grade', 'practise', 'next', 'note', 'at'])
          && portion(request.resource.data.notes.recited)
          && portion(request.resource.data.notes.next)
          && (request.resource.data.notes.grade == null || request.resource.data.notes.grade in [0, 1, 2])
          && request.resource.data.notes.practise.size() <= 300
          && text(request.resource.data.notes.note, 2000))
        || (signedIn() && request.auth.uid == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
          && request.resource.data.rating in [0, 1, 2]);
      allow delete: if false;
    }

    // Reports about a user. Anyone signed in can send one; admins read them.
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId', 'reporterName', 'reportedId', 'reportedName',
             'conversationId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && text(request.resource.data.details, 1000);
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Who can review applications. Added by hand in the console.
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }
  }
}
