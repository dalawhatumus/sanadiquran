rules_version = '2';

// Sanadi Firestore rules. Paste into Firebase console → Firestore → Rules.
// Nothing is readable without signing in; people only see their own data,
// except the "available" switch of approved teachers (to count them).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function isApproved(uid) {
      let app = /databases/$(db)/documents/teacherApplications/$(uid);
      return exists(app) && get(app).data.status == 'approved';
    }
    function text(v, max) { return v == null || (v is string && v.size() <= max); }
    // A teacher's gender is the one on their application, which an admin
    // checked when approving it (an approved application can't be edited).
    // An admin has paused this account (see /suspensions).
    function paused(uid) { return exists(/databases/$(db)/documents/suspensions/$(uid)); }
    function teacherGender(uid) {
      return get(/databases/$(db)/documents/teacherApplications/$(uid)).data.gender;
    }
    // A picture: one of the drawn avatars (a short id), or the person's own
    // photo ("photo:<their uid>:<version>", see /photos).
    // A server time the app may only set to "now" (or leave as it was);
    // stampOnce can't change once set.
    function stamp(k) {
      return request.resource.data.get(k, null) == (resource == null ? null : resource.data.get(k, null))
        || request.resource.data.get(k, null) == request.time;
    }
    function stampOnce(k) {
      return request.resource.data.get(k, null) == (resource == null ? null : resource.data.get(k, null))
        || ((resource == null || resource.data.get(k, null) == null) && request.resource.data.get(k, null) == request.time);
    }
    function validAvatar(v, uid) {
      return v == null || (v is string
        && ((v.size() <= 20 && !v.matches('photo:.*')) || v.matches('photo:' + uid + ':[a-z0-9]{1,12}')));
    }

    // Profile: name, role, gender, picture, language, and the details asked
    // when signing up (age group, nationality, phone number, and whether
    // they'd like to join the WhatsApp community). Only the person and
    // admins can read it, so the phone number is never shown to others.
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'role', 'gender', 'avatar', 'locale', 'ageGroup',
             'nationality', 'phone', 'whatsapp', 'updatedAt', 'createdAt', 'lastActive'])
        // When they joined (set once) and when they last opened the app,
        // both stamped by the server, for the admins' overview.
        && stampOnce('createdAt')
        && stamp('lastActive')
        && text(request.resource.data.get('name', null), 80)
        && request.resource.data.get('role', null) in [null, 'student', 'teacher']
        && request.resource.data.get('gender', null) in [null, 'male', 'female']
        && validAvatar(request.resource.data.get('avatar', null), uid)
        && request.resource.data.get('locale', null) in [null, 'ar', 'en']
        && request.resource.data.get('ageGroup', null) in [null, '18-24', '25-34', '35-44', '45-54', '55-64', '65+']
        && (request.resource.data.get('nationality', null) == null
            || (request.resource.data.nationality is string && request.resource.data.nationality.matches('[A-Z]{2}')))
        && (request.resource.data.get('phone', null) == null
            || (request.resource.data.phone is string && request.resource.data.phone.matches('[+][1-9][0-9]{6,14}')))
        && request.resource.data.get('whatsapp', false) is bool
        // Gender is chosen once: it decides who can call whom. It is kept
        // in /genders too, which can never change or be deleted, so deleting
        // and re-creating the profile can't change it either.
        && (resource == null || resource.data.get('gender', null) == null
            || request.resource.data.get('gender', null) == resource.data.gender)
        && (request.resource.data.get('gender', null) == null
            || getAfter(/databases/$(db)/documents/genders/$(uid)).data.gender == request.resource.data.gender);
      allow delete: if isMe(uid);
    }

    // The gender each account chose, set once (with the profile) and never
    // changed or removed. Only the person and admins can read it.
    match /genders/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['gender'])
        && request.resource.data.gender in ['male', 'female']
        // An account that already had a gender keeps it.
        && (!exists(/databases/$(db)/documents/users/$(uid))
            || get(/databases/$(db)/documents/users/$(uid)).data.get('gender', null) == null
            || get(/databases/$(db)/documents/users/$(uid)).data.gender == request.resource.data.gender);
      // Saving it again (unchanged) is allowed, so the app can always send it.
      allow update: if isMe(uid) && request.resource.data == resource.data;
      allow delete: if false;
    }

    // Teacher applications. The applicant can send (or resend after a
    // "not approved"); only an admin can approve or turn down.
    match /teacherApplications/{uid} {
      allow read: if isMe(uid) || isAdmin();
      function validApplication() {
        let a = request.resource.data.answers;
        return request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['name', 'gender', 'answers', 'order', 'sampleSec', 'status', 'submittedAt'])
          && text(request.resource.data.name, 80)
          // The same gender as the applicant's profile.
          && request.resource.data.gender == userDoc(uid).gender
          && request.resource.data.submittedAt == request.time
          && request.resource.data.get('sampleSec', 0) is int
          && a is map
          && a.keys().hasOnly(['Country', 'Languages', 'Can teach', 'Free times', 'Memorised', 'Ijazah / teachers',
               'Recording sample', 'Pledge'])
          && text(a.get('Country', null), 100) && text(a.get('Languages', null), 500)
          && text(a.get('Can teach', null), 500) && text(a.get('Free times', null), 500)
          && text(a.get('Memorised', null), 200) && text(a.get('Ijazah / teachers', null), 2000)
          && text(a.get('Recording sample', null), 100) && text(a.get('Pledge', null), 20)
          && request.resource.data.order is list
          && request.resource.data.order.size() <= 20;
      }
      allow create: if isMe(uid) && !paused(uid) && validApplication();
      allow update: if (isMe(uid) && !paused(uid) && resource.data.status in ['pending', 'rejected'] && validApplication())
        || (isAdmin()
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reason', 'decidedAt', 'decidedBy'])
          && text(request.resource.data.get('reason', null), 1000)
          && request.resource.data.get('decidedBy', null) == request.auth.uid);
      // Deleting the account removes the application too.
      allow delete: if isMe(uid);
    }

    // An applicant's recitation sample (at most about 2 minutes of AAC),
    // kept apart so the list of applications stays light.
    match /applicationSamples/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid) && !paused(uid)
        && request.resource.data.keys().hasOnly(['data', 'durationSec', 'createdAt'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 900000
        && request.resource.data.durationSec is int
        && request.resource.data.durationSec >= 0 && request.resource.data.durationSec <= 150
        && request.resource.data.createdAt == request.time;
      allow delete: if isMe(uid);
    }

    // "I'm available to teach", with the teacher's name and picture for the
    // teacher list. Only approved teachers set it; students see only
    // teachers of their own gender.
    match /presence/{uid} {
      allow read: if isMe(uid) || isAdmin()
        || (signedIn() && (resource == null || resource.data.gender == userDoc(request.auth.uid).gender));
      allow create, update: if isMe(uid) && isApproved(uid) && !paused(uid)
        && request.resource.data.keys().hasOnly(['available', 'gender', 'busy', 'name', 'avatar', 'lessonsToday',
             'lessonsDay', 'updatedAt'])
        && text(request.resource.data.get('name', null), 80)
        && validAvatar(request.resource.data.get('avatar', null), uid)
        // Lessons given today, so calls are shared out among teachers.
        && (request.resource.data.get('lessonsToday', 0) is int
            && request.resource.data.get('lessonsToday', 0) >= 0
            && request.resource.data.get('lessonsToday', 0) <= 200)
        && text(request.resource.data.get('lessonsDay', null), 10)
        && request.resource.data.available is bool
        && request.resource.data.get('busy', false) is bool
        && stamp('updatedAt')
        && request.resource.data.gender == teacherGender(uid);
      // An admin pausing a teacher removes them from the list too.
      allow delete: if isMe(uid) || isAdmin();
    }

    // An available teacher's "still here", every minute (kept apart from
    // /presence, which students watch: a beat there would cost each of them
    // a read every minute). Only a time; students only ring teachers whose
    // beat is recent.
    match /beats/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if isMe(uid);
    }

    // Chat between a student and a teacher. Only an admin opens a
    // conversation (later: the first lesson), and only between a student
    // and a teacher of the same gender. Only the two members can read it.
    function userDoc(uid) { return get(/databases/$(db)/documents/users/$(uid)).data; }
    function convDoc(cid) { return get(/databases/$(db)/documents/conversations/$(cid)).data; }
    function isMemberOf(cid) { return signedIn() && request.auth.uid in convDoc(cid).members; }
    function callDoc(id) { return get(/databases/$(db)/documents/calls/$(id)).data; }

    match /conversations/{cid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      // ...or the student, right after their first call with that teacher.
      // A new chat: the two members with their names and pictures, no
      // messages yet.
      function newChat() {
        let d = request.resource.data;
        let m = d.members;
        return m.size() == 2
          && cid == m[0] + '_' + m[1]
          && d.keys().hasOnly(['members', 'names', 'avatars', 'roles', 'gender', 'unread', 'blockedBy', 'lastText',
               'fromCall', 'createdBy', 'createdAt'])
          && d.names.keys().hasOnly(m) && text(d.names.get(m[0], null), 80) && text(d.names.get(m[1], null), 80)
          && d.avatars.keys().hasOnly(m)
          && validAvatar(d.avatars.get(m[0], null), m[0]) && validAvatar(d.avatars.get(m[1], null), m[1])
          && d.roles == {m[0]: 'student', m[1]: 'teacher'}
          && d.unread == {m[0]: 0, m[1]: 0}
          && d.blockedBy.size() == 0
          && d.lastText == ''
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }
      // (A call ends only after it was answered, so an ended call was a
      // real lesson.)
      allow create: if signedIn() && !paused(request.auth.uid)
        && newChat()
        && request.auth.uid == request.resource.data.members[0]
        && request.resource.data.fromCall is string
        && callDoc(request.resource.data.fromCall).studentId == request.resource.data.members[0]
        && callDoc(request.resource.data.fromCall).teacherId == request.resource.data.members[1]
        && callDoc(request.resource.data.fromCall).status in ['active', 'ended']
        && request.resource.data.gender == callDoc(request.resource.data.fromCall).gender;
      allow create: if isAdmin()
        && newChat()
        && !('fromCall' in request.resource.data)
        && userDoc(request.resource.data.members[0]).role == 'student'
        && isApproved(request.resource.data.members[1])
        && userDoc(request.resource.data.members[0]).gender == teacherGender(request.resource.data.members[1]);
      // Members update the preview, unread counts, their own name and
      // picture, and their own block; never who is in it.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.gender == resource.data.gender
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastText', 'lastVoiceSec', 'lastSender', 'lastAt', 'unread', 'names', 'avatars', 'blockedBy',
                       'sent'])
        && request.resource.data.blockedBy.removeAll([request.auth.uid])
             == resource.data.blockedBy.removeAll([request.auth.uid])
        // Each member changes only their own name and picture.
        && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.get('avatars', {}).diff(resource.data.get('avatars', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        // How many messages each member has sent (a number only, for the
        // admins); each counts their own.
        && request.resource.data.get('sent', {}).diff(resource.data.get('sent', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && text(request.resource.data.get('names', {}).get(request.auth.uid, null), 80)
        && validAvatar(request.resource.data.get('avatars', {}).get(request.auth.uid, null), request.auth.uid)
        && previewOk();
      // The last message's preview (120 letters at most), who sent it and
      // when, and small counters.
      function count(v) { return v is int && v >= 0 && v <= 1000000; }
      function previewOk() {
        let d = request.resource.data;
        let m = resource.data.members;
        let changed = d.diff(resource.data).affectedKeys();
        return text(d.get('lastText', null), 130)
          && (d.get('lastVoiceSec', null) == null || (d.lastVoiceSec is int && d.lastVoiceSec >= 0 && d.lastVoiceSec <= 185))
          && (!('lastSender' in changed) || d.lastSender == request.auth.uid)
          && (!('lastAt' in changed) || d.lastAt == request.time)
          && d.get('unread', {}).keys().hasOnly(m)
          && count(d.get('unread', {}).get(m[0], 0)) && count(d.get('unread', {}).get(m[1], 0))
          && count(d.get('sent', {}).get(request.auth.uid, 0));
      }
      allow delete: if false;

      function canSend() {
        return isMemberOf(cid) && convDoc(cid).blockedBy.size() == 0
          && request.resource.data.senderId == request.auth.uid
          && !paused(request.auth.uid);
      }

      match /messages/{mid} {
        allow read: if isMemberOf(cid);
        allow create: if canSend()
          && request.resource.data.sentAt == request.time
          && ((request.resource.data.type == 'text'
                && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'sentAt'])
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 2000)
            || (request.resource.data.type == 'voice'
                && request.resource.data.keys().hasOnly(['senderId', 'type', 'durationSec', 'sentAt'])
                && request.resource.data.durationSec is int
                && request.resource.data.durationSec <= 185));
        allow update: if false;
        allow delete: if isMemberOf(cid) && resource.data.senderId == request.auth.uid;
      }

      // Voice note recordings (at most about 3 minutes of AAC).
      match /audio/{mid} {
        allow read: if isMemberOf(cid);
        // Only together with its voice message (no recordings on their own).
        allow create: if canSend()
          && request.resource.data.keys().hasOnly(['senderId', 'data', 'createdAt'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(db)/documents/conversations/$(cid)/messages/$(mid)).data.type == 'voice'
          && getAfter(/databases/$(db)/documents/conversations/$(cid)/messages/$(mid)).data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if isMemberOf(cid) && resource.data.senderId == request.auth.uid;
      }
    }

    // Calls. The student's app finds a free teacher of the same gender and
    // rings them; the teacher's app answers. A teacher can also ring one of
    // their own students (someone they share a chat with); the student
    // answers. Only those two can see a call.
    match /calls/{id} {
      function isStudent() { return signedIn() && request.auth.uid == resource.data.studentId; }
      function isTeacher() { return signedIn() && request.auth.uid == resource.data.teacherId; }
      function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
      // Rung by the teacher (rather than found by the student).
      function fromTeacher() { return resource.data.get('direction', '') == 'toStudent'; }

      // Admins see calls too, for the overview (e.g. students who found no
      // teacher).
      allow read: if isStudent() || isTeacher() || isAdmin();
      allow create: if signedIn() && !paused(request.auth.uid)
        && request.resource.data.studentId == request.auth.uid
        && userDoc(request.auth.uid).role == 'student'
        && request.resource.data.gender == userDoc(request.auth.uid).gender
        && request.resource.data.status == 'searching'
        && request.resource.data.teacherId == null
        && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'studentAvatar', 'gender', 'status',
             'teacherId', 'tried', 'createdAt'])
        && text(request.resource.data.get('studentName', null), 80)
        && validAvatar(request.resource.data.get('studentAvatar', null), request.auth.uid);
      // A teacher rings their own student: approved, not paused, same gender,
      // with a chat between them; neither of them paused.
      allow create: if signedIn() && !paused(request.auth.uid)
        && request.resource.data.direction == 'toStudent'
        && request.resource.data.teacherId == request.auth.uid
        && isApproved(request.auth.uid)
        && request.resource.data.status == 'ringing'
        && request.resource.data.gender == teacherGender(request.auth.uid)
        && userDoc(request.resource.data.studentId).gender == teacherGender(request.auth.uid)
        && !paused(request.resource.data.studentId)
        && exists(/databases/$(db)/documents/conversations/$(request.resource.data.studentId + '_' + request.auth.uid))
        && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'studentAvatar', 'teacherId',
             'teacherName', 'teacherAvatar', 'gender', 'status', 'direction', 'tried', 'createdAt'])
        && text(request.resource.data.get('studentName', null), 80)
        && text(request.resource.data.get('teacherName', null), 80)
        && validAvatar(request.resource.data.get('studentAvatar', null), request.resource.data.studentId)
        && validAvatar(request.resource.data.get('teacherAvatar', null), request.auth.uid);
      // What a call holds, and the sizes allowed.
      function callShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['studentId', 'studentName', 'studentAvatar', 'teacherId', 'teacherName',
             'teacherAvatar', 'gender', 'status', 'direction', 'tried', 'createdAt', 'ringAt', 'acceptedAt',
             'endedAt', 'offer', 'answer'])
          && d.status in ['searching', 'ringing', 'declined', 'active', 'ended', 'cancelled', 'unmatched']
          && text(d.get('studentName', null), 80) && text(d.get('teacherName', null), 80)
          && d.get('tried', []) is list && d.get('tried', []).size() <= 60
          && description(d.get('offer', null)) && description(d.get('answer', null))
          && stamp('ringAt') && stamp('endedAt');
      }
      // A WebRTC session description: {type, sdp} (an audio-only one is a
      // few thousand letters).
      function description(v) {
        return v == null || (v is map && v.keys().hasOnly(['type', 'sdp'])
          && v.type in ['offer', 'answer'] && v.sdp is string && v.sdp.size() <= 20000);
      }
      function from(states) { return resource.data.status in states; }
      function to(states) { return request.resource.data.status in states; }
      function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
      // Deleting an account blanks the person's own name and picture.
      function scrubbed(nameKey, avatarKey) {
        return only([nameKey, avatarKey])
          && request.resource.data.get(nameKey, '') == '' && request.resource.data.get(avatarKey, null) == null;
      }
      // After a call, either phone removes the connection details (they hold
      // network addresses).
      function routesCleared() {
        return from(['ended', 'cancelled', 'unmatched', 'declined']) && only(['offer', 'answer'])
          && !('offer' in request.resource.data) && !('answer' in request.resource.data);
      }

      // The student looks for a teacher: rings one (approved, the same
      // gender, available and not paused), goes back to looking when they
      // don't answer, cancels or gives up; and, once answered, sends the
      // offer and hangs up. A call only ends after it was answered, and an
      // ended, cancelled or unmatched call never changes again.
      allow update: if isStudent() && !fromTeacher() && callShape()
        && unchanged(['studentId', 'gender', 'direction', 'teacherName', 'teacherAvatar', 'answer', 'createdAt',
             'acceptedAt'])
        && (scrubbed('studentName', 'studentAvatar') || routesCleared()
          || (from(['searching']) && to(['ringing', 'cancelled', 'unmatched']))
          || (from(['ringing', 'declined']) && to(['searching', 'cancelled', 'unmatched']))
          || (from(['active']) && to(['ended']) && only(['status', 'endedAt']))
          || (from(['active']) && to(['active']) && only(['offer'])))
        && (to(['ringing'])
          ? (!paused(request.auth.uid)
            && isApproved(request.resource.data.teacherId)
            && !paused(request.resource.data.teacherId)
            && teacherGender(request.resource.data.teacherId) == resource.data.gender
            && get(/databases/$(db)/documents/presence/$(request.resource.data.teacherId)).data.available == true)
          : unchanged(['teacherId', 'tried']));
      // For a call from their teacher, the student answers or declines it,
      // then sends the offer and can hang up; they can't put anyone else
      // through.
      allow update: if isStudent() && fromTeacher() && callShape()
        && unchanged(['studentId', 'gender', 'direction', 'teacherId', 'tried', 'teacherName', 'teacherAvatar',
             'answer', 'createdAt', 'ringAt'])
        && (scrubbed('studentName', 'studentAvatar') || routesCleared()
          || (from(['ringing']) && to(['declined']) && only(['status']))
          || (from(['ringing']) && to(['active']) && only(['status', 'acceptedAt'])
              && request.resource.data.acceptedAt == request.time && !paused(request.auth.uid))
          || (from(['active']) && to(['ended']) && only(['status', 'endedAt']))
          || (from(['active']) && to(['active']) && only(['offer'])));
      // The teacher being rung answers (with their name and picture) or
      // declines, then sends the answer and can hang up.
      // For a call the teacher made, they can't answer it themselves, but
      // can give up while it rings (cancelled, or unmatched: no answer).
      allow update: if isTeacher() && callShape()
        && unchanged(['studentId', 'studentName', 'studentAvatar', 'gender', 'teacherId', 'tried', 'offer',
             'direction', 'createdAt', 'ringAt'])
        && (scrubbed('teacherName', 'teacherAvatar') || routesCleared()
          || (!fromTeacher() && from(['ringing']) && to(['declined']) && only(['status']))
          || (!fromTeacher() && from(['ringing']) && to(['active'])
              && only(['status', 'teacherName', 'teacherAvatar', 'acceptedAt'])
              && request.resource.data.acceptedAt == request.time
              && validAvatar(request.resource.data.get('teacherAvatar', null), request.auth.uid)
              && !paused(request.auth.uid))
          || (fromTeacher() && from(['ringing']) && to(['cancelled', 'unmatched']) && only(['status', 'endedAt']))
          || (from(['active']) && to(['ended']) && only(['status', 'endedAt']))
          || (from(['active']) && to(['active']) && only(['answer'])));
      allow delete: if false;

      // Network routes for the connection, from each side, while the call is
      // on. Each phone removes its own when the call is over.
      match /ice/{c} {
        allow read: if signedIn() && request.auth.uid in [callDoc(id).studentId, callDoc(id).teacherId];
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
          && callDoc(id).status == 'active'
          && request.resource.data.keys().hasOnly(['from', 'senderId', 'c'])
          && request.resource.data.c is map
          && request.resource.data.c.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
          && text(request.resource.data.c.get('candidate', null), 1000)
          && text(request.resource.data.c.get('sdpMid', null), 20)
          && ((request.resource.data.from == 'student' && request.auth.uid == callDoc(id).studentId)
              || (request.resource.data.from == 'teacher' && request.auth.uid == callDoc(id).teacherId));
        allow update: if false;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Lessons (calls that connected): saved by either person when the call
    // ends, matching the call. Only the teacher writes notes; only the
    // student rates.
    match /sessions/{id} {
      function inLesson() {
        return signedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.teacherId);
      }
      function portion(p) {
        return p == null || (p is map && p.keys().hasOnly(['sura', 'from', 'to'])
          && p.sura is int && p.sura >= 1 && p.sura <= 114 && p.from is int && p.to is int && p.from <= p.to);
      }

      allow read: if inLesson() || isAdmin();
      allow create: if signedIn()
        && request.auth.uid in [request.resource.data.studentId, request.resource.data.teacherId]
        && callDoc(id).studentId == request.resource.data.studentId
        && callDoc(id).teacherId == request.resource.data.teacherId
        && callDoc(id).status in ['active', 'ended']
        && request.resource.data.gender == callDoc(id).gender
        && request.resource.data.keys().hasOnly(['studentId', 'teacherId', 'studentName', 'teacherName',
             'studentAvatar', 'teacherAvatar', 'gender', 'startedAt', 'durationSec', 'createdAt'])
        && text(request.resource.data.get('studentName', null), 80)
        && text(request.resource.data.get('teacherName', null), 80)
        && validAvatar(request.resource.data.get('studentAvatar', null), request.resource.data.studentId)
        && validAvatar(request.resource.data.get('teacherAvatar', null), request.resource.data.teacherId)
        && request.resource.data.createdAt == request.time
        // When it started, and how long it lasted: no longer than the time
        // since the call was answered (plus a little for clocks).
        && request.resource.data.startedAt is timestamp
        && request.resource.data.startedAt > request.time - duration.value(4, 'h')
        && request.resource.data.startedAt < request.time + duration.value(10, 'm')
        && request.resource.data.durationSec is int
        && request.resource.data.durationSec >= 0
        && callDoc(id).acceptedAt is timestamp
        && request.resource.data.durationSec <= (request.time - callDoc(id).acceptedAt).seconds() + 120;
      allow update: if (signedIn() && request.auth.uid == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
          && request.resource.data.notes.keys().hasOnly(['recited', 'grade', 'practise', 'next', 'note', 'at'])
          && portion(request.resource.data.notes.recited)
          && portion(request.resource.data.notes.next)
          && (request.resource.data.notes.grade == null || request.resource.data.notes.grade in [0, 1, 2])
          && request.resource.data.notes.practise.size() <= 300
          && text(request.resource.data.notes.note, 2000))
        || (signedIn() && request.auth.uid == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
          && request.resource.data.rating in [0, 1, 2])
        // Deleting an account blanks the person's own name and picture.
        || (signedIn() && request.auth.uid == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentName', 'studentAvatar'])
          && request.resource.data.get('studentName', '') == '' && request.resource.data.get('studentAvatar', null) == null)
        || (signedIn() && request.auth.uid == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherName', 'teacherAvatar'])
          && request.resource.data.get('teacherName', '') == '' && request.resource.data.get('teacherAvatar', null) == null);
      allow delete: if false;
    }

    // Reports about a user. Anyone signed in can send one; admins read them.
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId', 'reporterName', 'reportedId', 'reportedName',
             'conversationId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason in ['words', 'respect', 'personal', 'other']
        && text(request.resource.data.details, 1000)
        && text(request.resource.data.reporterName, 80)
        && text(request.resource.data.reportedName, 80)
        // About the other member of one of the reporter's own chats.
        && request.resource.data.reportedId != request.auth.uid
        && request.auth.uid in convDoc(request.resource.data.conversationId).members
        && request.resource.data.reportedId in convDoc(request.resource.data.conversationId).members;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy'])
        && request.resource.data.status in ['open', 'resolved'];
      allow delete: if false;
    }

    // Students waiting for a teacher ("Alert me when a teacher is free"),
    // for an hour at most. Teachers of the same gender see how many.
    match /waiting/{uid} {
      allow read: if isMe(uid) || isAdmin()
        || (isApproved(request.auth.uid) && resource.data.gender == teacherGender(request.auth.uid));
      allow create, update: if isMe(uid) && !paused(uid)
        && request.resource.data.keys().hasOnly(['gender', 'until'])
        && request.resource.data.gender == userDoc(uid).gender
        && request.resource.data.until is timestamp
        && request.resource.data.until > request.time - duration.value(5, 'm')
        && request.resource.data.until <= request.time + duration.value(65, 'm');
      allow delete: if isMe(uid);
    }

    // Paused accounts. Only admins pause and restore; the person can see
    // that their own account is paused.
    match /suspensions/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
        && text(request.resource.data.reason, 500)
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    // A person's own profile photo: a small JPEG (the free plan has no file
    // storage). Seen by people of the same gender (the only people they
    // can meet in Sanadi) and admins; an admin can remove it.
    match /photos/{uid} {
      allow read: if isMe(uid) || isAdmin()
        || (signedIn() && userDoc(uid).gender != null && userDoc(request.auth.uid).gender == userDoc(uid).gender);
      allow create, update: if isMe(uid) && !paused(uid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 150000;
      allow delete: if isMe(uid) || isAdmin();
    }

    // Admins. The first is added by hand in the console; admins can add
    // and remove others (but not themselves, so there's always one left).
    match /admins/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isAdmin() && exists(/databases/$(db)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
        && text(request.resource.data.get('name', null), 80)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Announcements shown in the app, written by admins: English and/or
    // Arabic text, for everyone or only students or only teachers, until a
    // date (or until removed).
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['textEn', 'textAr', 'audience', 'until', 'by', 'at'])
        && text(request.resource.data.get('textEn', null), 500)
        && text(request.resource.data.get('textAr', null), 500)
        && (request.resource.data.get('textEn', '') != '' || request.resource.data.get('textAr', '') != '')
        && request.resource.data.audience in ['all', 'student', 'teacher']
        && (request.resource.data.get('until', null) == null || request.resource.data.until is timestamp)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
